PORT=3000
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/petnica
# Si tu proveedor exige SSL, configura PGSSL=true
PGSSL=false
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=pon_aqui_un_secreto_aleatorio_largo
# Set true only behind a trusted HTTPS reverse proxy.
TRUST_PROXY=false
# Cookie de sesión solo por HTTPS. Por defecto: true en Vercel/producción.
# Pon false solo si pruebas el build de producción en local sin TLS.
SESSION_COOKIE_SECURE=
# Número de WhatsApp Business con código de país, solo dígitos
WHATSAPP_NUMBER=50588880000

# Imágenes de producto: auto usa Supabase si hay credenciales y disco local si no.
# En Vercel/producción se requiere Supabase; el disco serverless no es persistente.
PRODUCT_IMAGE_STORAGE=auto
SUPABASE_URL=https://yfdvktpohgritupbliwl.supabase.co
# Clave secreta de servidor (sb_secret_... o service_role); nunca la pongas en el frontend.
SUPABASE_SECRET_KEY=
# Alternativa para proyectos antiguos: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_PRODUCT_IMAGE_PREFIX=products
# Opcional en local; por defecto usa backend-serverless/public/images.
PRODUCT_IMAGE_DIR=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/account/google/callback
